# Ignore unnecessary files for Docker build

# Git
.git
.gitignore
.gitattributes

# IDE
.idea
.vscode
*.iml
*.ipr
*.iws

# Build output (except the JAR we need)
build/
!modules/api/build/libs/*.jar
.gradle/
node_modules/
dist/

# Test files
**/test/
**/*Test.java
**/*Tests.java

# Documentation
*.md
docs/
.kiro/

# Local config
.env
.env.*
*.log
*.pid

# OS files
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp
*~
