    /**
     * Test: Complete workflow from ingredient creation to recipe costing
     * Requirements: 1.1-1.5, 2.1-2.2, 3.1-3.2, 4.1-4.2
     */
    @Test
    void testCompleteIngredientToRecipeWorkflow() {
        // Create ingredients with different yields
        Ingredient chicken = ingredientService.createIngredient(
                venueId,
                "Chicken Breast",
                new BigDecimal("30.00"),
                new BigDecimal("2.5000"),
                UomEnum.KILOGRAM,
                new BigDecimal("75.00")  // 75% yield
        );

        // Verify cost calculations with yield
        // cost_per_unit = 30.00 / 2.5 = 12.0000
        assertThat(chicken.getCostPerUnit()).isEqualByComparingTo(new BigDecimal("12.0000"));
        
        // effective_cost = 12.0000 / 0.75 = 16.0000
        assertThat(chicken.getEffectiveCostPerUsableUnit())
                .isEqualByComparingTo(new BigDecimal("16.0000"));

        Ingredient rice = ingredientService.createIngredient(
                venueId,
                "Basmati Rice",
                new BigDecimal("15.00"),
                new BigDecimal("5.0000"),
                UomEnum.KILOGRAM,
                new BigDecimal("100.00")  // 100% yield
        );

        // Create recipe
        Recipe chickenRice = recipeService.createRecipe(
                venueId,
                "Chicken & Rice Bowl",
                15,  // 15 portions
                List.of(),
                false
        );

        chickenRice.setMenuSellingPrice(new BigDecimal("18.00"));  // $18 menu price
        chickenRice = recipeRepository.save(chickenRice);

        // Add ingredient lines
        createIngredientLine(chickenRice.getId(), chicken.getId(), null, new BigDecimal("1.0000"), UomEnum.KILOGRAM);
        createIngredientLine(chickenRice.getId(), rice.getId(), null, new BigDecimal("0.5000"), UomEnum.KILOGRAM);

        // Calculate recipe costs
        Recipe calculated = calculateAndUpdateRecipeCost(chickenRice);

        // Verify cost calculations
        // chicken: 1.0 kg * 16.0000 (effective cost) = 16.00
        // rice: 0.5 kg * (15.00 / 5) = 0.5 * 3.00 = 1.50
        // total_batch_cost = 16.00 + 1.50 = 17.50
        assertThat(calculated.getTotalBatchCost()).isEqualByComparingTo(new BigDecimal("17.50"));

        // food_cost_per_portion = 17.50 / 15 = 1.17 (rounded to 2 d.p.)
        assertThat(calculated.getFoodCostPerPortion())
                .isEqualByComparingTo(new BigDecimal("1.17"));

        // food_cost_percentage = (1.17 / 18.00) * 100 = 6.5% (rounded to 1 d.p.)
        assertThat(calculated.getFoodCostPercentage())
                .isEqualByComparingTo(new BigDecimal("6.5"));
    }

    /**
     * Test: Sub-recipe support in cost calculation
     * Requirements: 2.3, 3.4
     */
    @Test
    void testSubRecipeCostCalculation() {
        // Create ingredients for sauce
        Ingredient tomatoes = ingredientService.createIngredient(
                venueId,
                "Crushed Tomatoes",
                new BigDecimal("4.00"),
                new BigDecimal("1.0000"),
                UomEnum.KILOGRAM,
                new BigDecimal("100.00")
        );

        Ingredient garlic = ingredientService.createIngredient(
                venueId,
                "Garlic",
                new BigDecimal("2.00"),
                new BigDecimal("0.1000"),
                UomEnum.KILOGRAM,
                new BigDecimal("95.00")
        );

        // Create sub-recipe (sauce)
        Recipe tomatoSauce = recipeService.createRecipe(
                venueId,
                "Tomato Sauce",
                10,  // 10 portions
                List.of(),
                false
        );

        createIngredientLine(tomatoSauce.getId(), tomatoes.getId(), null, new BigDecimal("0.5000"), UomEnum.KILOGRAM);
        createIngredientLine(tomatoSauce.getId(), garlic.getId(), null, new BigDecimal("0.02"), UomEnum.KILOGRAM);

        // Calculate sauce cost
        tomatoSauce = calculateAndUpdateRecipeCost(tomatoSauce);

        // tomatoes: 0.5 kg * 4.00 = 2.00
        // garlic: 0.02 kg * (2.00 / 0.1) * (1/0.95) = 0.02 * 20 * 1.0526 = 0.42
        // total_batch_cost = 2.00 + 0.42 = 2.42
        // food_cost_per_portion = 2.42 / 10 = 0.24
        assertThat(tomatoSauce.getFoodCostPerPortion())
                .isEqualByComparingTo(new BigDecimal("0.24"));

        // Create main recipe that uses the sauce as a sub-recipe
        Ingredient pasta = ingredientService.createIngredient(
                venueId,
                "Pasta",
                new BigDecimal("12.00"),
                new BigDecimal("5.0000"),
                UomEnum.KILOGRAM,
                new BigDecimal("100.00")
        );

        Recipe pastaDish = recipeService.createRecipe(
                venueId,
                "Pasta Marinara",
                4,  // 4 portions
                List.of(),
                false
        );

        pastaDish.setMenuSellingPrice(new BigDecimal("15.00"));
        pastaDish = recipeRepository.save(pastaDish);

        createIngredientLine(pastaDish.getId(), pasta.getId(), null, new BigDecimal("0.4000"), UomEnum.KILOGRAM);

        // Add sauce as sub-recipe (2 portions of sauce)
        createIngredientLine(pastaDish.getId(), null, tomatoSauce.getId(), new BigDecimal("2.0000"), UomEnum.EACH);

        // Calculate pasta dish cost
        pastaDish = calculateAndUpdateRecipeCost(pastaDish);

        // pasta: 0.4 kg * (12.00 / 5) = 0.4 * 2.40 = 0.96
        // sauce: 2 portions * 0.24 = 0.48
        // total_batch_cost = 0.96 + 0.48 = 1.44
        // food_cost_per_portion = 1.44 / 4 = 0.36
        assertThat(pastaDish.getTotalBatchCost())
                .isEqualByComparingTo(new BigDecimal("1.44"));
        assertThat(pastaDish.getFoodCostPerPortion())
                .isEqualByComparingTo(new BigDecimal("0.36"));
    }

    /**
     * Test: Database constraints and transactions
     * Requirements: 1.8 (delete with references), 1.10 (duplicate name check)
     */
    @Test
    void testDatabaseConstraintsWithRealDatabase() {
        // Create ingredient
        Ingredient ingredient = ingredientService.createIngredient(
                venueId,
                "Test Ingredient",
                new BigDecimal("10.00"),
                new BigDecimal("1.0000"),
                UomEnum.KILOGRAM,
                new BigDecimal("100.00")
        );

        // Create recipe that references the ingredient
        Recipe recipe = recipeService.createRecipe(
                venueId,
                "Test Recipe",
                5,
                List.of(),
                false
        );

        createIngredientLine(recipe.getId(), ingredient.getId(), null, new BigDecimal("0.5000"), UomEnum.KILOGRAM);

        // Try to delete ingredient without confirmation - should fail
        assertThatThrownBy(() ->
                ingredientService.deleteIngredient(venueId, ingredient.getId(), false))
                .hasMessageContaining("referenced by");

        // Delete with confirmation should succeed
        ingredientService.deleteIngredient(venueId, ingredient.getId(), true);

        // Verify ingredient is deleted
        assertThatThrownBy(() ->
                ingredientService.getIngredient(venueId, ingredient.getId()))
                .hasMessageContaining("not found");

        // Test duplicate name rejection
        ingredientService.createIngredient(
                venueId,
                "Unique Ingredient",
                new BigDecimal("5.00"),
                new BigDecimal("1.0000"),
                UomEnum.KILOGRAM,
                new BigDecimal("100.00")
        );

        // Try to create with same name (case-insensitive) - should fail
        assertThatThrownBy(() ->
                ingredientService.createIngredient(
                        venueId,
                        "UNIQUE INGREDIENT",
                        new BigDecimal("5.00"),
                        new BigDecimal("1.0000"),
                        UomEnum.KILOGRAM,
                        new BigDecimal("100.00")
                ))
                .hasMessageContaining("duplicate");
    }
}
