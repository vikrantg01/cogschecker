# Staging Environment Configuration
# 
# This file should be used when running E2E tests against the staging environment.
# Copy this to .env.staging.local and update with actual staging values.
# 
# Usage: BASE_URL=https://staging.example.com npm run test:e2e

# Staging API URL (update with actual staging ALB DNS)
VITE_API_BASE_URL=https://staging-alb.amazonaws.com/api/v1

# Staging Cognito Configuration (update with actual values from CDK outputs)
# VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXX
# VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXX
# VITE_COGNITO_DOMAIN=foodcost-staging.auth.us-east-1.amazoncognito.com

# Playwright test configuration
BASE_URL=https://staging.example.com
