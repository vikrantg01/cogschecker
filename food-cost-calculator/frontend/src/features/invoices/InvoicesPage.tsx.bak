import { useState, useRef } from 'react';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { apiClient } from '../../lib/api';
import { useVenueStore } from '../../store/venueSlice';
import type { Invoice, InvoiceLineItem } from '../../types/api';

export const InvoicesPage = () => {
  const currentVenueId = useVenueStore((state) => state.currentVenueId);
  const queryClient = useQueryClient();
  const fileInputRef = useRef<HTMLInputElement>(null);
  
  const [selectedInvoice, setSelectedInvoice] = useState<string | null>(null);
  const [uploadProgress, setUploadProgress] = useState<number>(0);
  const [isUploading, setIsUploading] = useState(false);
  const [editedLineItems, setEditedLineItems] = useState<Record<string, Partial<InvoiceLineItem>>>({});

  // Fetch invoice detail
  const { data: invoiceDetail, isLoading: detailLoading } = useQuery({
    queryKey: ['invoice-detail', currentVenueId, selectedInvoice],
    queryFn: async () => {
      const response = await apiClient.get<Invoice>(
        `/venues/${currentVenueId}/invoices/${selectedInvoice}`
      );
      return response.data;
    },
    enabled: !!currentVenueId && !!selectedInvoice,
  });

  // Upload mutation
  const uploadMutation = useMutation({
    mutationFn: async (file: File) => {
      setIsUploading(true);
      setUploadProgress(0);

      const formData = new FormData();
      formData.append('file', file);

      const response = await apiClient.post(
        `/venues/${currentVenueId}/invoices`,
        formData,
        {
          headers: {
            'Content-Type': 'multipart/form-data',
          },
          onUploadProgress: (progressEvent) => {
            if (progressEvent.total) {
              const percentCompleted = Math.round(
                (progressEvent.loaded * 100) / progressEvent.total
              );
              setUploadProgress(percentCompleted);
            }
          },
        }
      );
      return response.data;
    },
    onSuccess: (data) => {
      setIsUploading(false);
      setUploadProgress(0);
      setSelectedInvoice(data.invoice_id);
      queryClient.invalidateQueries({ queryKey: ['invoice-detail', currentVenueId] });
      if (fileInputRef.current) {
        fileInputRef.current.value = '';
      }
    },
    onError: (error: any) => {
      setIsUploading(false);
      setUploadProgress(0);
      alert(error.response?.data?.message || 'Failed to upload invoice');
    },
  });

  // Update line item mutation
  const updateLineItemMutation = useMutation({
    mutationFn: async ({ 
      invoiceId, 
      lineId, 
      updates 
    }: { 
      invoiceId: string; 
      lineId: string; 
      updates: Partial<InvoiceLineItem> 
    }) => {
      await apiClient.patch(
        `/venues/${currentVenueId}/invoices/${invoiceId}/lines/${lineId}`,
        {
          extracted_name: updates.extractedName,
          extracted_quantity: updates.extractedQuantity,
          extracted_unit: updates.extractedUnit,
          extracted_price: updates.extractedPrice,
        }
      );
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ 
        queryKey: ['invoice-detail', currentVenueId, selectedInvoice] 
      });
      setEditedLineItems({});
    },
  });

  // Confirm invoice mutation
  const confirmMutation = useMutation({
    mutationFn: async (invoiceId: string) => {
      await apiClient.post(
        `/venues/${currentVenueId}/invoices/${invoiceId}/confirm`
      );
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ 
        queryKey: ['invoice-detail', currentVenueId, selectedInvoice] 
      });
      setSelectedInvoice(null);
      alert('Invoice confirmed successfully! Ingredients have been updated.');
    },
  });

  const handleFileSelect = (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;

    // Validate file type
    const allowedTypes = ['application/pdf', 'image/jpeg', 'image/png'];
    if (!allowedTypes.includes(file.type)) {
      alert('Invalid file type. Please upload a PDF, JPEG, or PNG file.');
      return;
    }

    // Validate file size (10 MB)
    const maxSize = 10 * 1024 * 1024;
    if (file.size > maxSize) {
      alert('File size exceeds 10 MB limit.');
      return;
    }

    uploadMutation.mutate(file);
  };

  const handleLineItemEdit = (lineId: string, field: string, value: any) => {
    setEditedLineItems({
      ...editedLineItems,
      [lineId]: {
        ...editedLineItems[lineId],
        [field]: value,
      },
    });
  };

  const handleSaveLineItem = (lineId: string) => {
    if (!selectedInvoice || !editedLineItems[lineId]) return;
    
    updateLineItemMutation.mutate({
      invoiceId: selectedInvoice,
      lineId,
      updates: editedLineItems[lineId],
    });
  };

  const handleConfirmInvoice = () => {
    if (!selectedInvoice) return;

    // Check for low-confidence items that haven't been edited
    const lowConfidenceItems = invoiceDetail?.lineItems?.filter(
      (item) => item.isLowConfidence && !editedLineItems[item.id]
    );

    if (lowConfidenceItems && lowConfidenceItems.length > 0) {
      const confirm = window.confirm(
        `There are ${lowConfidenceItems.length} low-confidence items that haven't been reviewed. Continue anyway?`
      );
      if (!confirm) return;
    }

    confirmMutation.mutate(selectedInvoice);
  };

  const getLineItemValue = (item: InvoiceLineItem, field: keyof InvoiceLineItem) => {
    if (editedLineItems[item.id]?.[field] !== undefined) {
      return editedLineItems[item.id][field];
    }
    return item[field];
  };

  return (
    <div className="invoices-page max-w-7xl mx-auto">
      <h1 className="text-3xl font-bold mb-6">Invoice Upload</h1>

      {/* Upload Section */}
      <div className="bg-white p-6 rounded-lg shadow mb-6">
        <h2 className="text-xl font-semibold mb-4">Upload Supplier Invoice</h2>
        <p className="text-gray-600 mb-4">
          Upload a PDF or image (JPEG, PNG) of your supplier invoice. The system will extract ingredient data automatically.
        </p>
        
        <div className="mb-4">
          <input
            ref={fileInputRef}
            type="file"
            accept=".pdf,.jpg,.jpeg,.png"
            onChange={handleFileSelect}
            disabled={isUploading}
            className="block w-full text-sm text-gray-500
              file:mr-4 file:py-2 file:px-4
              file:rounded file:border-0
              file:text-sm file:font-semibold
              file:bg-blue-50 file:text-blue-700
              hover:file:bg-blue-100
              disabled:opacity-50 disabled:cursor-not-allowed"
          />
        </div>

        {isUploading && (
          <div className="mt-4">
            <div className="flex justify-between mb-1">
              <span className="text-sm font-medium text-gray-700">Uploading...</span>
              <span className="text-sm font-medium text-gray-700">{uploadProgress}%</span>
            </div>
            <div className="w-full bg-gray-200 rounded-full h-2.5">
              <div
                className="bg-blue-600 h-2.5 rounded-full transition-all duration-300"
                style={{ width: `${uploadProgress}%` }}
              ></div>
            </div>
          </div>
        )}
      </div>

      {/* Invoice Detail Section */}
      {selectedInvoice && (
        <div className="bg-white p-6 rounded-lg shadow">
          <h2 className="text-xl font-semibold mb-4">Review Extracted Data</h2>

          {detailLoading ? (
            <p className="text-gray-600">Loading invoice details...</p>
          ) : invoiceDetail?.processingStatus === 'processing' ? (
            <div className="text-center py-8">
              <div className="inline-block animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mb-4"></div>
              <p className="text-gray-600">Processing invoice with OCR... This may take up to 30 seconds.</p>
            </div>
          ) : invoiceDetail?.processingStatus === 'failed' ? (
            <div className="bg-red-50 border border-red-200 rounded p-4">
              <p className="text-red-800">Invoice processing failed. Please try uploading again.</p>
            </div>
          ) : invoiceDetail?.processingStatus === 'confirmed' ? (
            <div className="bg-green-50 border border-green-200 rounded p-4">
              <p className="text-green-800">This invoice has been confirmed and applied to your ingredients.</p>
            </div>
          ) : invoiceDetail?.lineItems && invoiceDetail.lineItems.length > 0 ? (
            <>
              <div className="mb-4">
                <p className="text-sm text-gray-600">
                  <strong>File:</strong> {invoiceDetail.fileName} | 
                  <strong className="ml-2">Items extracted:</strong> {invoiceDetail.extractedItemCount}
                </p>
              </div>

              <div className="overflow-x-auto mb-4">
                <table className="min-w-full divide-y divide-gray-200">
                  <thead className="bg-gray-50">
                    <tr>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Item Name
                      </th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Quantity
                      </th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Unit
                      </th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Price
                      </th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Confidence
                      </th>
                      <th className="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Actions
                      </th>
                    </tr>
                  </thead>
                  <tbody className="bg-white divide-y divide-gray-200">
                    {invoiceDetail.lineItems.map((item) => {
                      const isEditing = !!editedLineItems[item.id];
                      const isLowConfidence = item.isLowConfidence;

                      return (
                        <tr 
                          key={item.id}
                          className={isLowConfidence ? 'bg-yellow-50' : ''}
                        >
                          <td className="px-4 py-3 text-sm">
                            {isEditing ? (
                              <input
                                type="text"
                                value={getLineItemValue(item, 'extractedName') as string}
                                onChange={(e) => handleLineItemEdit(item.id, 'extractedName', e.target.value)}
                                className="w-full px-2 py-1 border border-gray-300 rounded"
                              />
                            ) : (
                              <span className={isLowConfidence ? 'font-semibold text-yellow-800' : ''}>
                                {item.extractedName}
                              </span>
                            )}
                          </td>
                          <td className="px-4 py-3 text-sm">
                            {isEditing ? (
                              <input
                                type="number"
                                step="0.01"
                                value={getLineItemValue(item, 'extractedQuantity') as number || ''}
                                onChange={(e) => handleLineItemEdit(item.id, 'extractedQuantity', parseFloat(e.target.value))}
                                className="w-20 px-2 py-1 border border-gray-300 rounded"
                              />
                            ) : (
                              <span className={isLowConfidence ? 'font-semibold text-yellow-800' : ''}>
                                {item.extractedQuantity?.toFixed(2) || 'N/A'}
                              </span>
                            )}
                          </td>
                          <td className="px-4 py-3 text-sm">
                            {isEditing ? (
                              <input
                                type="text"
                                value={getLineItemValue(item, 'extractedUnit') as string || ''}
                                onChange={(e) => handleLineItemEdit(item.id, 'extractedUnit', e.target.value)}
                                className="w-20 px-2 py-1 border border-gray-300 rounded"
                              />
                            ) : (
                              <span className={isLowConfidence ? 'font-semibold text-yellow-800' : ''}>
                                {item.extractedUnit || 'N/A'}
                              </span>
                            )}
                          </td>
                          <td className="px-4 py-3 text-sm">
                            {isEditing ? (
                              <input
                                type="number"
                                step="0.01"
                                value={getLineItemValue(item, 'extractedPrice') as number || ''}
                                onChange={(e) => handleLineItemEdit(item.id, 'extractedPrice', parseFloat(e.target.value))}
                                className="w-24 px-2 py-1 border border-gray-300 rounded"
                              />
                            ) : (
                              <span className={isLowConfidence ? 'font-semibold text-yellow-800' : ''}>
                                ${item.extractedPrice?.toFixed(2) || 'N/A'}
                              </span>
                            )}
                          </td>
                          <td className="px-4 py-3 text-sm">
                            <span className={`px-2 py-1 text-xs font-medium rounded ${
                              isLowConfidence
                                ? 'bg-yellow-200 text-yellow-900'
                                : 'bg-green-100 text-green-800'
                            }`}>
                              {(item.confidenceScore * 100).toFixed(0)}%
                            </span>
                          </td>
                          <td className="px-4 py-3 text-sm">
                            {isEditing ? (
                              <button
                                onClick={() => handleSaveLineItem(item.id)}
                                disabled={updateLineItemMutation.isPending}
                                className="px-3 py-1 bg-green-600 text-white rounded hover:bg-green-700 transition disabled:opacity-50"
                              >
                                Save
                              </button>
                            ) : (
                              <button
                                onClick={() => handleLineItemEdit(item.id, 'extractedName', item.extractedName)}
                                className="px-3 py-1 bg-blue-600 text-white rounded hover:bg-blue-700 transition"
                              >
                                Edit
                              </button>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>

              <div className="flex justify-end gap-4">
                <button
                  onClick={() => setSelectedInvoice(null)}
                  className="px-4 py-2 bg-gray-600 text-white rounded hover:bg-gray-700 transition"
                >
                  Cancel
                </button>
                <button
                  onClick={handleConfirmInvoice}
                  disabled={confirmMutation.isPending}
                  className="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition disabled:opacity-50"
                >
                  {confirmMutation.isPending ? 'Confirming...' : 'Confirm & Apply to Ingredients'}
                </button>
              </div>
            </>
          ) : (
            <p className="text-gray-600">No line items found in this invoice.</p>
          )}
        </div>
      )}
    </div>
  );
};
