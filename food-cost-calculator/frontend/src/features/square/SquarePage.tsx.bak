import { useState } from 'react';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { apiClient } from '../../lib/api';
import { useVenueStore } from '../../store/venueSlice';
import type { SquareConnection, SquareUnmatchedItem } from '../../types/api';

export const SquarePage = () => {
  const currentVenueId = useVenueStore((state) => state.currentVenueId);
  const queryClient = useQueryClient();
  const [selectedRecipeId, setSelectedRecipeId] = useState<Record<string, string>>({});

  // Fetch Square connection status
  const { data: connection, isLoading: connectionLoading } = useQuery({
    queryKey: ['square-connection', currentVenueId],
    queryFn: async () => {
      const response = await apiClient.get<SquareConnection>(
        `/venues/${currentVenueId}/square/connection`
      );
      return response.data;
    },
    enabled: !!currentVenueId,
  });

  // Fetch unmatched items
  const { data: unmatchedItems = [], isLoading: unmatchedLoading } = useQuery({
    queryKey: ['square-unmatched', currentVenueId],
    queryFn: async () => {
      const response = await apiClient.get<SquareUnmatchedItem[]>(
        `/venues/${currentVenueId}/square/unmatched`
      );
      return response.data;
    },
    enabled: !!currentVenueId && connection?.connected,
  });

  // Disconnect mutation
  const disconnectMutation = useMutation({
    mutationFn: async () => {
      await apiClient.delete(`/venues/${currentVenueId}/square/connection`);
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['square-connection', currentVenueId] });
      queryClient.invalidateQueries({ queryKey: ['square-unmatched', currentVenueId] });
    },
  });

  // Update unmatched item mutation
  const updateUnmatchedMutation = useMutation({
    mutationFn: async ({ itemId, status, mappedRecipeId }: { 
      itemId: string; 
      status: string; 
      mappedRecipeId?: string 
    }) => {
      await apiClient.patch(
        `/venues/${currentVenueId}/square/unmatched/${itemId}`,
        { status, mapped_recipe_id: mappedRecipeId }
      );
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['square-unmatched', currentVenueId] });
    },
  });

  const handleConnect = () => {
    // Redirect to Square OAuth flow
    window.location.href = `${apiClient.defaults.baseURL}/venues/${currentVenueId}/square/connect`;
  };

  const handleDisconnect = async () => {
    if (confirm('Are you sure you want to disconnect Square POS? Synced prices will be retained.')) {
      await disconnectMutation.mutateAsync();
    }
  };

  const handleMapItem = (itemId: string) => {
    const recipeId = selectedRecipeId[itemId];
    if (!recipeId) {
      alert('Please select a recipe to map this item to.');
      return;
    }
    updateUnmatchedMutation.mutate({ 
      itemId, 
      status: 'mapped', 
      mappedRecipeId: recipeId 
    });
  };

  const handleDismissItem = (itemId: string) => {
    updateUnmatchedMutation.mutate({ itemId, status: 'dismissed' });
  };

  if (connectionLoading) {
    return (
      <div className="square-page">
        <h1 className="text-3xl font-bold mb-6">Square POS Integration</h1>
        <div className="bg-white p-6 rounded-lg shadow">
          <p className="text-gray-600">Loading connection status...</p>
        </div>
      </div>
    );
  }

  const isConnected = connection?.connected ?? false;

  return (
    <div className="square-page max-w-6xl mx-auto">
      <h1 className="text-3xl font-bold mb-6">Square POS Integration</h1>

      {/* Connection Status Card */}
      <div className="bg-white p-6 rounded-lg shadow mb-6">
        <h2 className="text-xl font-semibold mb-4">Connection Status</h2>
        
        {!isConnected ? (
          <div>
            <p className="text-gray-600 mb-4">
              Connect your Square POS account to automatically sync menu item prices and sales data.
            </p>
            <button
              onClick={handleConnect}
              className="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition"
            >
              Connect Square POS
            </button>
          </div>
        ) : (
          <div>
            <div className="grid grid-cols-2 gap-4 mb-4">
              <div>
                <p className="text-sm text-gray-500">Merchant ID</p>
                <p className="font-medium">{connection?.merchantId || 'N/A'}</p>
              </div>
              <div>
                <p className="text-sm text-gray-500">Last Synced</p>
                <p className="font-medium">
                  {connection?.lastSyncedAt 
                    ? new Date(connection.lastSyncedAt).toLocaleString() 
                    : 'Never'}
                </p>
              </div>
              <div>
                <p className="text-sm text-gray-500">Sync Status</p>
                <p className="font-medium capitalize">
                  {connection?.syncStatus || 'Idle'}
                </p>
              </div>
            </div>
            <button
              onClick={handleDisconnect}
              disabled={disconnectMutation.isPending}
              className="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition disabled:opacity-50"
            >
              {disconnectMutation.isPending ? 'Disconnecting...' : 'Disconnect'}
            </button>
          </div>
        )}
      </div>

      {/* Unmatched Items Section */}
      {isConnected && (
        <div className="bg-white p-6 rounded-lg shadow">
          <h2 className="text-xl font-semibold mb-4">Unmatched Square Items</h2>
          
          {unmatchedLoading ? (
            <p className="text-gray-600">Loading unmatched items...</p>
          ) : unmatchedItems.length === 0 ? (
            <p className="text-gray-600">
              All Square menu items are matched with recipes. Great job!
            </p>
          ) : (
            <div className="overflow-x-auto">
              <table className="min-w-full divide-y divide-gray-200">
                <thead className="bg-gray-50">
                  <tr>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Square Item Name
                    </th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Price
                    </th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Status
                    </th>
                    <th className="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                      Actions
                    </th>
                  </tr>
                </thead>
                <tbody className="bg-white divide-y divide-gray-200">
                  {unmatchedItems.map((item) => (
                    <tr key={item.id}>
                      <td className="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                        {item.squareItemName}
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        ${item.squareItemPrice.toFixed(2)}
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap">
                        <span className={`px-2 py-1 text-xs font-medium rounded ${
                          item.status === 'pending' 
                            ? 'bg-yellow-100 text-yellow-800'
                            : item.status === 'mapped'
                            ? 'bg-green-100 text-green-800'
                            : 'bg-gray-100 text-gray-800'
                        }`}>
                          {item.status}
                        </span>
                      </td>
                      <td className="px-6 py-4 whitespace-nowrap text-sm">
                        {item.status === 'pending' && (
                          <div className="flex items-center gap-2">
                            <input
                              type="text"
                              placeholder="Recipe ID"
                              value={selectedRecipeId[item.id] || ''}
                              onChange={(e) => 
                                setSelectedRecipeId({ ...selectedRecipeId, [item.id]: e.target.value })
                              }
                              className="px-2 py-1 border border-gray-300 rounded text-sm"
                            />
                            <button
                              onClick={() => handleMapItem(item.id)}
                              disabled={updateUnmatchedMutation.isPending}
                              className="px-3 py-1 bg-green-600 text-white rounded hover:bg-green-700 transition disabled:opacity-50"
                            >
                              Map
                            </button>
                            <button
                              onClick={() => handleDismissItem(item.id)}
                              disabled={updateUnmatchedMutation.isPending}
                              className="px-3 py-1 bg-gray-600 text-white rounded hover:bg-gray-700 transition disabled:opacity-50"
                            >
                              Dismiss
                            </button>
                          </div>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      )}
    </div>
  );
};
