import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { useNavigate } from 'react-router-dom';
import { apiClient } from '../../lib/api';
import { useVenueStore } from '../../store/venueSlice';
import { useSubscriptionGate } from '../../shared/hooks/useSubscriptionGate';
import { UpgradeModal } from '../../shared/components/UpgradeModal';
import type { AIInsight, InsightDataAvailability } from '../../types/api';

export const InsightsPage = () => {
  const currentVenueId = useVenueStore((state) => state.currentVenueId);
  const queryClient = useQueryClient();
  const navigate = useNavigate();
  const { showUpgradeModal, requiredTier, upgradeMessage, closeModal, handleApiError } = useSubscriptionGate();

  // Fetch insights
  const { data: insights = [], isLoading: insightsLoading, error: insightsError } = useQuery({
    queryKey: ['insights', currentVenueId],
    queryFn: async () => {
      try {
        const response = await apiClient.get<AIInsight[]>(`/venues/${currentVenueId}/insights`);
        return response.data;
      } catch (error) {
        if (!handleApiError(error)) {
          throw error;
        }
        return [];
      }
    },
    enabled: !!currentVenueId,
  });

  // Fetch data availability status
  const { data: dataAvailability, isLoading: availabilityLoading } = useQuery({
    queryKey: ['insights-availability', currentVenueId],
    queryFn: async () => {
      try {
        const response = await apiClient.get<InsightDataAvailability>(
          `/venues/${currentVenueId}/insights/availability`
        );
        return response.data;
      } catch (error) {
        if (!handleApiError(error)) {
          throw error;
        }
        return null;
      }
    },
    enabled: !!currentVenueId,
  });

  // Update insight status mutation
  const updateStatusMutation = useMutation({
    mutationFn: async ({ id, status }: { id: string; status: 'actioned' | 'dismissed' }) => {
      await apiClient.patch(`/venues/${currentVenueId}/insights/${id}/status`, { status });
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['insights', currentVenueId] });
    },
  });

  const handleStatusUpdate = (insightId: string, status: 'actioned' | 'dismissed') => {
    updateStatusMutation.mutate({ id: insightId, status });
  };

  const getInsightIcon = (type: AIInsight['insightType']) => {
    if (type === 'recipe_profitability') {
      return (
        <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
      );
    }
    return (
      <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    );
  };

  const getInsightTypeLabel = (type: AIInsight['insightType']) => {
    return type === 'recipe_profitability' ? 'Recipe Profitability' : 'Supplier Cost';
  };

  const getInsightTypeBadgeColor = (type: AIInsight['insightType']) => {
    return type === 'recipe_profitability' 
      ? 'bg-purple-100 text-purple-700' 
      : 'bg-amber-100 text-amber-700';
  };

  const formatDate = (dateString: string) => {
    const date = new Date(dateString);
    return new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
    }).format(date);
  };

  const activeInsights = insights.filter(i => i.status === 'active');

  if (!currentVenueId) {
    return (
      <div className="p-6">
        <div className="alert alert-warning">
          <span>Please select a venue to view AI insights.</span>
        </div>
      </div>
    );
  }

  const isLoading = insightsLoading || availabilityLoading;

  return (
    <div className="p-6 max-w-7xl mx-auto">
      {/* Header */}
      <div className="mb-6">
        <div className="flex items-center gap-3 mb-2">
          <h1 className="text-3xl font-bold text-gray-900">AI Insights</h1>
          <span className="badge" style={{ background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)', color: 'white' }}>
            Pro+
          </span>
        </div>
        <p className="text-gray-600">
          AI-driven insights to optimize recipe profitability and manage supplier costs.
        </p>
      </div>

      {/* Loading State */}
      {isLoading && (
        <div className="flex items-center justify-center py-12">
          <span className="spinner" style={{ width: '2rem', height: '2rem' }}></span>
          <span className="ml-3 text-gray-600">Loading insights...</span>
        </div>
      )}

      {/* Error State */}
      {insightsError && !showUpgradeModal && (
        <div className="alert alert-error">
          <span>Failed to load insights. Please try again.</span>
        </div>
      )}

      {/* Insufficient Data Message */}
      {!isLoading && dataAvailability && !dataAvailability.hasSufficientData && (
        <div className="card card-lg mb-6 bg-gradient-to-br from-blue-50 to-purple-50 border-blue-200">
          <div className="flex items-start gap-4">
            <div className="flex-shrink-0 w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
              <svg className="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div className="flex-1">
              <h3 className="text-lg font-semibold text-gray-900 mb-2">
                Gathering Data for Insights
              </h3>
              <p className="text-gray-700 mb-3">
                {dataAvailability.message || 
                  `We need at least ${dataAvailability.minimumDaysRequired} days of sales data to generate meaningful insights. Currently, we have ${dataAvailability.daysOfData || 0} days of data.`
                }
              </p>
              {dataAvailability.estimatedAvailableDate && (
                <p className="text-sm text-gray-600">
                  <span className="font-semibold">Estimated availability:</span>{' '}
                  {formatDate(dataAvailability.estimatedAvailableDate)}
                </p>
              )}
              <div className="mt-4 pt-4 border-t border-blue-200">
                <p className="text-sm text-gray-600 mb-2">
                  <strong>To generate insights, you need:</strong>
                </p>
                <ul className="list-disc list-inside text-sm text-gray-600 space-y-1">
                  <li>At least 30 days of Square POS sales data</li>
                  <li>At least 10 sales transactions recorded</li>
                  <li>Active Pro+ subscription</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Insights Grid */}
      {!isLoading && dataAvailability?.hasSufficientData && activeInsights.length > 0 && (
        <div className="space-y-4">
          {/* Last Updated Info */}
          {activeInsights.length > 0 && (
            <div className="text-sm text-gray-500 mb-4">
              Last updated: {formatDate(activeInsights[0].generatedAt)}
            </div>
          )}

          {/* Insight Cards */}
          {activeInsights.map((insight) => (
            <div
              key={insight.id}
              className="card card-lg hover:shadow-lg transition-shadow duration-200 border-l-4"
              style={{
                borderLeftColor: insight.insightType === 'recipe_profitability' ? '#9333ea' : '#f59e0b'
              }}
            >
              {/* Card Header */}
              <div className="flex items-start justify-between mb-4">
                <div className="flex items-start gap-4 flex-1">
                  <div className={`flex-shrink-0 w-12 h-12 rounded-lg flex items-center justify-center ${
                    insight.insightType === 'recipe_profitability' 
                      ? 'bg-purple-100 text-purple-600' 
                      : 'bg-amber-100 text-amber-600'
                  }`}>
                    {getInsightIcon(insight.insightType)}
                  </div>
                  <div className="flex-1">
                    <div className="flex items-center gap-2 mb-2">
                      <span className={`badge ${getInsightTypeBadgeColor(insight.insightType)}`}>
                        {getInsightTypeLabel(insight.insightType)}
                      </span>
                    </div>
                    <h3 className="text-xl font-semibold text-gray-900 mb-2">
                      {insight.title}
                    </h3>
                  </div>
                </div>
              </div>

              {/* Explanation */}
              <div className="mb-4">
                <p className="text-gray-700 leading-relaxed">
                  {insight.explanation}
                </p>
              </div>

              {/* Supporting Data */}
              {insight.supportingData && Object.keys(insight.supportingData).length > 0 && (
                <div className="mb-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
                  <h4 className="text-sm font-semibold text-gray-700 mb-3">Supporting Data</h4>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {Object.entries(insight.supportingData).map(([key, value]) => (
                      <div key={key} className="flex justify-between items-center">
                        <span className="text-sm text-gray-600 capitalize">
                          {key.replace(/_/g, ' ')}:
                        </span>
                        <span className="text-sm font-medium text-gray-900">
                          {typeof value === 'number' && key.includes('percentage') 
                            ? `${value.toFixed(1)}%`
                            : typeof value === 'number' && key.includes('cost')
                            ? `$${value.toFixed(2)}`
                            : String(value)}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {/* Recommended Action */}
              <div className="mb-5 p-4 bg-blue-50 rounded-lg border border-blue-200">
                <div className="flex items-start gap-2">
                  <svg className="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  </svg>
                  <div className="flex-1">
                    <h4 className="text-sm font-semibold text-blue-900 mb-1">Recommended Action</h4>
                    <p className="text-sm text-blue-800">
                      {insight.recommendedAction}
                    </p>
                  </div>
                </div>
              </div>

              {/* Action Buttons */}
              <div className="flex gap-3 justify-end pt-4 border-t border-gray-200">
                <button
                  onClick={() => handleStatusUpdate(insight.id, 'dismissed')}
                  className="btn btn-secondary btn-sm"
                  disabled={updateStatusMutation.isPending}
                >
                  Dismiss
                </button>
                <button
                  onClick={() => handleStatusUpdate(insight.id, 'actioned')}
                  className="btn btn-primary btn-sm"
                  disabled={updateStatusMutation.isPending}
                >
                  {updateStatusMutation.isPending ? (
                    <>
                      <span className="spinner" style={{ width: '1rem', height: '1rem' }}></span>
                      Updating...
                    </>
                  ) : (
                    <>
                      <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                      </svg>
                      Mark as Actioned
                    </>
                  )}
                </button>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Empty State - No Active Insights */}
      {!isLoading && dataAvailability?.hasSufficientData && activeInsights.length === 0 && (
        <div className="card card-lg text-center py-12">
          <div className="flex flex-col items-center">
            <div className="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
              <svg className="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <h3 className="text-lg font-semibold text-gray-900 mb-2">
              No Active Insights
            </h3>
            <p className="text-gray-600 max-w-md">
              All insights have been actioned or dismissed. New insights will appear here when our AI identifies opportunities for improvement.
            </p>
          </div>
        </div>
      )}

      {/* Upgrade Modal */}
      <UpgradeModal
        isOpen={showUpgradeModal}
        onClose={closeModal}
        requiredTier={requiredTier || 'pro_plus'}
        message={upgradeMessage || undefined}
        onUpgrade={() => navigate('/account/subscription')}
      />
    </div>
  );
};
