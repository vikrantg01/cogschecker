import { useState } from 'react';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { useVenueStore } from '../../store/venueSlice';
import type { SubscriptionTier, DowngradeConflictResponse } from '../../types/api';
import {
  getSubscription,
  getSubscriptionHistory,
  upgradeSubscription,
  scheduleDowngrade,
  cancelPendingDowngrade,
  checkDowngradeConflicts,
} from './api/subscriptionApi';
import { CurrentTierBadge } from './components/CurrentTierBadge';
import { BillingInfo } from './components/BillingInfo';
import { PaymentFailedBanner } from './components/PaymentFailedBanner';
import { UpgradeDowngradePanel } from './components/UpgradeDowngradePanel';
import { SubscriptionHistory } from './components/SubscriptionHistory';
import { StripePaymentModal } from './components/StripePaymentModal';
import { DowngradeConflictModal } from './components/DowngradeConflictModal';

/**
 * AccountPage - main account settings page with subscription management.
 * Requirements: 11.1, 11.4, 11.5, 11.6, 11.7, 11.8, 11.9
 *
 * Displays:
 * - Current tier badge
 * - Billing renewal date
 * - Upgrade/downgrade flows with Stripe payment element
 * - Subscription history list
 * - In-app payment-failed banner
 */
export const AccountPage = () => {
  const queryClient = useQueryClient();
  const currentVenue = useVenueStore((state) => state.getCurrentVenue());
  const orgId = currentVenue?.organisationId;

  const [showPaymentModal, setShowPaymentModal] = useState(false);
  const [selectedUpgradeTier, setSelectedUpgradeTier] = useState<SubscriptionTier | null>(null);
  const [showConflictModal, setShowConflictModal] = useState(false);
  const [conflictData, setConflictData] = useState<DowngradeConflictResponse | null>(null);

  // Fetch subscription details
  const { data: subscription, isLoading: isLoadingSubscription } = useQuery({
    queryKey: ['subscription', orgId],
    queryFn: () => getSubscription(orgId!),
    enabled: !!orgId,
  });

  // Fetch subscription history
  const { data: history = [], isLoading: isLoadingHistory } = useQuery({
    queryKey: ['subscription-history', orgId],
    queryFn: () => getSubscriptionHistory(orgId!),
    enabled: !!orgId,
  });

  // Upgrade mutation
  const upgradeMutation = useMutation({
    mutationFn: (data: {
      targetTier: SubscriptionTier;
      stripeCustomerId: string;
      stripeSubscriptionId: string;
      currentPeriodEnd: string;
    }) =>
      upgradeSubscription(orgId!, {
        targetTier: data.targetTier,
        stripeCustomerId: data.stripeCustomerId,
        stripeSubscriptionId: data.stripeSubscriptionId,
        currentPeriodEnd: data.currentPeriodEnd,
      }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['subscription', orgId] });
      queryClient.invalidateQueries({ queryKey: ['subscription-history', orgId] });
    },
  });

  // Downgrade mutation
  const downgradeMutation = useMutation({
    mutationFn: (targetTier: SubscriptionTier) =>
      scheduleDowngrade(orgId!, { targetTier }),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['subscription', orgId] });
      queryClient.invalidateQueries({ queryKey: ['subscription-history', orgId] });
    },
    onError: (error: any) => {
      // Check if it's a conflict error (409)
      if (error.response?.status === 409) {
        const conflictResponse = error.response.data as DowngradeConflictResponse;
        setConflictData(conflictResponse);
        setShowConflictModal(true);
      }
    },
  });

  // Cancel downgrade mutation
  const cancelDowngradeMutation = useMutation({
    mutationFn: () => cancelPendingDowngrade(orgId!),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['subscription', orgId] });
      queryClient.invalidateQueries({ queryKey: ['subscription-history', orgId] });
    },
  });

  const handleUpgrade = (targetTier: SubscriptionTier) => {
    setSelectedUpgradeTier(targetTier);
    setShowPaymentModal(true);
  };

  const handlePaymentComplete = (
    stripeCustomerId: string,
    stripeSubscriptionId: string,
    currentPeriodEnd: string
  ) => {
    if (selectedUpgradeTier) {
      upgradeMutation.mutate({
        targetTier: selectedUpgradeTier,
        stripeCustomerId,
        stripeSubscriptionId,
        currentPeriodEnd,
      });
      setSelectedUpgradeTier(null);
    }
  };

  const handleDowngrade = async (targetTier: SubscriptionTier) => {
    // Check for conflicts first
    try {
      const conflicts = await checkDowngradeConflicts(orgId!, targetTier.toString());
      
      if (conflicts.excessVenueCount > 0 || Object.keys(conflicts.venuesWithExcessRecipes).length > 0) {
        setConflictData(conflicts);
        setShowConflictModal(true);
        return;
      }
      
      // No conflicts, proceed with downgrade
      downgradeMutation.mutate(targetTier);
    } catch (error) {
      console.error('Error checking downgrade conflicts:', error);
      // Proceed anyway and let the backend handle conflicts
      downgradeMutation.mutate(targetTier);
    }
  };

  const handleCancelDowngrade = () => {
    cancelDowngradeMutation.mutate();
  };

  const handleUpdatePayment = () => {
    // In production, this would open a Stripe customer portal or payment update flow
    console.log('Update payment information');
    alert('Update payment functionality would be implemented here using Stripe Customer Portal');
  };

  if (!orgId) {
    return (
      <div className="account-page">
        <h1 className="text-3xl font-bold mb-6">Account Settings</h1>
        <div className="bg-white p-6 rounded-lg shadow">
          <p className="text-gray-600">Please select a venue to view account settings.</p>
        </div>
      </div>
    );
  }

  if (isLoadingSubscription) {
    return (
      <div className="account-page">
        <h1 className="text-3xl font-bold mb-6">Account Settings</h1>
        <div className="bg-white p-6 rounded-lg shadow">
          <p className="text-gray-600">Loading subscription details...</p>
        </div>
      </div>
    );
  }

  if (!subscription) {
    return (
      <div className="account-page">
        <h1 className="text-3xl font-bold mb-6">Account Settings</h1>
        <div className="bg-white p-6 rounded-lg shadow">
          <p className="text-gray-600">No subscription found.</p>
        </div>
      </div>
    );
  }

  return (
    <div className="account-page max-w-6xl mx-auto">
      <h1 className="text-3xl font-bold mb-6">Account Settings</h1>

      {/* Payment Failed Banner - Requirement 11.8 */}
      {subscription.paymentFailedAt && (
        <PaymentFailedBanner
          paymentFailedAt={subscription.paymentFailedAt}
          onUpdatePayment={handleUpdatePayment}
        />
      )}

      {/* Current Tier and Billing Info */}
      <div className="bg-white rounded-lg shadow p-6 mb-6">
        <h2 className="text-lg font-semibold mb-4">Current Subscription</h2>
        
        <div className="mb-4">
          <label className="text-sm font-medium text-gray-700 block mb-2">Your Plan</label>
          <CurrentTierBadge
            tier={subscription.tier}
            pendingDowngradeTier={subscription.pendingDowngradeTier}
          />
        </div>

        <BillingInfo
          currentPeriodEnd={subscription.currentPeriodEnd}
          pendingDowngradeTier={subscription.pendingDowngradeTier}
        />
      </div>

      {/* Upgrade/Downgrade Panel */}
      <div className="mb-6">
        <UpgradeDowngradePanel
          currentTier={subscription.tier}
          pendingDowngradeTier={subscription.pendingDowngradeTier}
          onUpgrade={handleUpgrade}
          onDowngrade={handleDowngrade}
          onCancelDowngrade={handleCancelDowngrade}
        />
      </div>

      {/* Subscription History */}
      {!isLoadingHistory && <SubscriptionHistory history={history} />}

      {/* Stripe Payment Modal */}
      {selectedUpgradeTier && (
        <StripePaymentModal
          isOpen={showPaymentModal}
          onClose={() => {
            setShowPaymentModal(false);
            setSelectedUpgradeTier(null);
          }}
          targetTier={selectedUpgradeTier}
          onPaymentComplete={handlePaymentComplete}
        />
      )}

      {/* Downgrade Conflict Modal */}
      {conflictData && (
        <DowngradeConflictModal
          isOpen={showConflictModal}
          onClose={() => {
            setShowConflictModal(false);
            setConflictData(null);
          }}
          excessVenueCount={conflictData.excessVenueCount}
          venuesWithExcessRecipes={conflictData.venuesWithExcessRecipes}
        />
      )}
    </div>
  );
};
