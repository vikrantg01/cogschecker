import { useNavigate } from 'react-router-dom';
import { useVenueStore } from '../../store/venueSlice';
import { useAuthStore } from '../../store/authSlice';

export const VenuesPage = () => {
  const navigate = useNavigate();
  const { venues, currentVenueId, setCurrentVenue } = useVenueStore();
  const user = useAuthStore((state) => state.user);
  
  // TODO: Check if user is admin - for now assuming admin if user exists
  const isAdmin = !!user;

  const handleSelectVenue = (venueId: string) => {
    setCurrentVenue(venueId);
  };

  return (
    <div className="venues-page">
      <div style={{ 
        display: 'flex', 
        justifyContent: 'space-between', 
        alignItems: 'flex-start',
        marginBottom: '2rem',
        flexWrap: 'wrap',
        gap: '1rem',
      }}>
        <div>
          <h1 style={{ 
            fontSize: 'clamp(1.75rem, 4vw, 2.5rem)',
            fontWeight: '700',
            color: 'var(--text-primary)',
            marginBottom: '0.5rem',
          }}>
            Venues
          </h1>
          <p style={{ 
            color: 'var(--text-secondary)',
            fontSize: '0.9375rem',
          }}>
            Manage your locations and view performance across all venues
          </p>
        </div>
        
        {isAdmin && (
          <div style={{ display: 'flex', gap: '0.75rem', flexWrap: 'wrap' }}>
            <button
              onClick={() => navigate('/venues/cross-venue-summary')}
              className="btn-secondary"
            >
              📊 Cross-Venue Summary
            </button>
            <button
              onClick={() => navigate('/venues/create')}
              className="btn-primary"
            >
              + Create Venue
            </button>
          </div>
        )}
      </div>

      {venues.length === 0 ? (
        <div className="card card-lg" style={{ textAlign: 'center', padding: '3rem' }}>
          <div style={{ 
            fontSize: '3rem',
            marginBottom: '1rem',
          }}>
            🏢
          </div>
          <h2 style={{ 
            fontSize: '1.5rem',
            fontWeight: '600',
            marginBottom: '0.5rem',
          }}>
            No Venues Yet
          </h2>
          <p style={{ 
            color: 'var(--text-secondary)',
            marginBottom: '2rem',
          }}>
            Create your first venue to start tracking costs and recipes
          </p>
          {isAdmin && (
            <button
              onClick={() => navigate('/venues/create')}
              className="btn-primary"
            >
              Create Your First Venue
            </button>
          )}
        </div>
      ) : (
        <div style={{ 
          display: 'grid',
          gap: '1rem',
        }}>
          {venues.map((venue) => (
            <div
              key={venue.id}
              className="card card-interactive"
              style={{
                padding: '1.5rem',
                border: currentVenueId === venue.id 
                  ? '2px solid var(--primary-500)' 
                  : '1px solid var(--border-light)',
                background: currentVenueId === venue.id 
                  ? 'var(--primary-50)' 
                  : 'var(--bg-elevated)',
              }}
            >
              <div style={{ 
                display: 'flex',
                justifyContent: 'space-between',
                alignItems: 'flex-start',
                gap: '1rem',
              }}>
                <div style={{ flex: 1, minWidth: 0 }}>
                  <div style={{ 
                    display: 'flex',
                    alignItems: 'center',
                    gap: '0.75rem',
                    marginBottom: '0.5rem',
                  }}>
                    <h3 style={{ 
                      fontSize: '1.25rem',
                      fontWeight: '600',
                      color: 'var(--text-primary)',
                      margin: 0,
                    }}>
                      📍 {venue.name}
                    </h3>
                    {currentVenueId === venue.id && (
                      <span className="badge badge-primary">
                        Active
                      </span>
                    )}
                  </div>
                  {venue.address && (
                    <p style={{ 
                      color: 'var(--text-secondary)',
                      fontSize: '0.875rem',
                      margin: 0,
                    }}>
                      {venue.address}
                    </p>
                  )}
                </div>

                <div style={{ 
                  display: 'flex',
                  gap: '0.5rem',
                  flexShrink: 0,
                  flexWrap: 'wrap',
                  justifyContent: 'flex-end',
                }}>
                  {currentVenueId !== venue.id && (
                    <button
                      onClick={() => handleSelectVenue(venue.id)}
                      className="btn-secondary btn-sm"
                    >
                      Switch to This Venue
                    </button>
                  )}
                  {isAdmin && (
                    <>
                      <button
                        onClick={() => navigate(`/venues/${venue.id}/edit`)}
                        className="btn-ghost btn-sm"
                        title="Edit venue"
                      >
                        ✏️
                      </button>
                      <button
                        onClick={() => navigate(`/venues/${venue.id}/delete`)}
                        className="btn-ghost btn-sm"
                        title="Delete venue"
                        style={{ color: 'var(--error)' }}
                      >
                        🗑️
                      </button>
                    </>
                  )}
                </div>
              </div>

              <div style={{ 
                marginTop: '1rem',
                paddingTop: '1rem',
                borderTop: '1px solid var(--border-light)',
                fontSize: '0.75rem',
                color: 'var(--text-tertiary)',
              }}>
                ID: {venue.id.substring(0, 8)}...
              </div>
            </div>
          ))}
        </div>
      )}

      {venues.length > 0 && (
        <div style={{ 
          marginTop: '2rem',
          padding: '1rem',
          background: 'var(--bg-secondary)',
          borderRadius: '0.5rem',
          fontSize: '0.875rem',
          color: 'var(--text-secondary)',
        }}>
          <strong>Tip:</strong> Use the venue selector in the header to quickly switch between venues while working
        </div>
      )}
    </div>
  );
};
