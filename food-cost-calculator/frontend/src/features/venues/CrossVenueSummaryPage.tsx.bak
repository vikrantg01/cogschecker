import { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { apiClient } from '../../lib/api';
import { useAuthStore } from '../../store/authSlice';

interface VenueSummary {
  venueId: string;
  venueName: string;
  totalRecipes: number;
  averageFoodCostPercentage: number | null;
  recipesExceedingThreshold: number;
}

interface CrossVenueSummaryResponse {
  venues: VenueSummary[];
  organisationName: string;
  targetThreshold: number;
}

export const CrossVenueSummaryPage = () => {
  const navigate = useNavigate();
  const user = useAuthStore((state) => state.user);
  
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [summary, setSummary] = useState<CrossVenueSummaryResponse | null>(null);

  useEffect(() => {
    const fetchSummary = async () => {
      try {
        const orgId = user?.id || 'temp-org-id';
        const response = await apiClient.get<CrossVenueSummaryResponse>(
          `/organisations/${orgId}/reports/cross-venue`
        );
        setSummary(response.data);
      } catch (err: any) {
        if (err.response?.status === 403) {
          setError('You do not have permission to view cross-venue reports. Admin access required.');
        } else if (err.response?.data?.message) {
          setError(err.response.data.message);
        } else {
          setError('Failed to load cross-venue summary');
        }
      } finally {
        setLoading(false);
      }
    };

    fetchSummary();
  }, [user]);

  if (loading) {
    return (
      <div style={{ 
        display: 'flex', 
        justifyContent: 'center', 
        alignItems: 'center',
        minHeight: '400px',
      }}>
        <div style={{ textAlign: 'center' }}>
          <div className="spinner" style={{ 
            width: '2rem', 
            height: '2rem',
            margin: '0 auto 1rem',
          }} />
          <p style={{ color: 'var(--text-secondary)' }}>Loading summary...</p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="cross-venue-summary-page">
        <button
          onClick={() => navigate('/venues')}
          className="btn-ghost btn-sm"
          style={{ marginBottom: '1rem' }}
        >
          ← Back to Venues
        </button>
        <div className="alert alert-error">
          <svg 
            xmlns="http://www.w3.org/2000/svg" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor"
          >
            <path 
              strokeLinecap="round" 
              strokeLinejoin="round" 
              strokeWidth={2} 
              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" 
            />
          </svg>
          <span>{error}</span>
        </div>
      </div>
    );
  }

  if (!summary || summary.venues.length === 0) {
    return (
      <div className="cross-venue-summary-page">
        <button
          onClick={() => navigate('/venues')}
          className="btn-ghost btn-sm"
          style={{ marginBottom: '1rem' }}
        >
          ← Back to Venues
        </button>
        <div className="card card-lg" style={{ textAlign: 'center', padding: '3rem' }}>
          <h2 style={{ marginBottom: '1rem', color: 'var(--text-secondary)' }}>
            No Venues Found
          </h2>
          <p style={{ color: 'var(--text-tertiary)' }}>
            Create your first venue to see cross-venue analytics
          </p>
          <button
            onClick={() => navigate('/venues/create')}
            className="btn-primary"
            style={{ marginTop: '1.5rem' }}
          >
            Create Venue
          </button>
        </div>
      </div>
    );
  }

  const formatPercentage = (value: number | null): string => {
    if (value === null) return 'N/A';
    return `${value.toFixed(1)}%`;
  };

  const totalRecipes = summary.venues.reduce((sum, v) => sum + v.totalRecipes, 0);
  const totalExceeding = summary.venues.reduce((sum, v) => sum + v.recipesExceedingThreshold, 0);
  const avgCostPercentages = summary.venues
    .map(v => v.averageFoodCostPercentage)
    .filter((v): v is number => v !== null);
  const overallAverage = avgCostPercentages.length > 0
    ? avgCostPercentages.reduce((sum, v) => sum + v, 0) / avgCostPercentages.length
    : null;

  return (
    <div className="cross-venue-summary-page">
      <div style={{ marginBottom: '2rem' }}>
        <button
          onClick={() => navigate('/venues')}
          className="btn-ghost btn-sm"
          style={{ marginBottom: '1rem' }}
        >
          ← Back to Venues
        </button>
        <h1 style={{ 
          fontSize: 'clamp(1.75rem, 4vw, 2.5rem)',
          fontWeight: '700',
          color: 'var(--text-primary)',
          marginBottom: '0.5rem',
        }}>
          Cross-Venue Summary
        </h1>
        <p style={{ 
          color: 'var(--text-secondary)',
          fontSize: '0.9375rem',
        }}>
          Performance overview across all venues in {summary.organisationName || 'your organisation'}
        </p>
      </div>

      {/* Overall Stats */}
      <div style={{ 
        display: 'grid',
        gridTemplateColumns: 'repeat(auto-fit, minmax(220px, 1fr))',
        gap: '1.5rem',
        marginBottom: '2rem',
      }}>
        <div className="card" style={{ textAlign: 'center', padding: '1.5rem' }}>
          <div style={{ 
            fontSize: '2.5rem', 
            fontWeight: '700',
            color: 'var(--primary-600)',
            marginBottom: '0.5rem',
          }}>
            {summary.venues.length}
          </div>
          <div style={{ color: 'var(--text-secondary)', fontSize: '0.875rem' }}>
            Total Venues
          </div>
        </div>

        <div className="card" style={{ textAlign: 'center', padding: '1.5rem' }}>
          <div style={{ 
            fontSize: '2.5rem', 
            fontWeight: '700',
            color: 'var(--primary-600)',
            marginBottom: '0.5rem',
          }}>
            {totalRecipes}
          </div>
          <div style={{ color: 'var(--text-secondary)', fontSize: '0.875rem' }}>
            Total Recipes
          </div>
        </div>

        <div className="card" style={{ textAlign: 'center', padding: '1.5rem' }}>
          <div style={{ 
            fontSize: '2.5rem', 
            fontWeight: '700',
            color: overallAverage && overallAverage > summary.targetThreshold 
              ? 'var(--error)' 
              : 'var(--success)',
            marginBottom: '0.5rem',
          }}>
            {formatPercentage(overallAverage)}
          </div>
          <div style={{ color: 'var(--text-secondary)', fontSize: '0.875rem' }}>
            Average Cost %
          </div>
        </div>

        <div className="card" style={{ textAlign: 'center', padding: '1.5rem' }}>
          <div style={{ 
            fontSize: '2.5rem', 
            fontWeight: '700',
            color: totalExceeding > 0 ? 'var(--warning)' : 'var(--success)',
            marginBottom: '0.5rem',
          }}>
            {totalExceeding}
          </div>
          <div style={{ color: 'var(--text-secondary)', fontSize: '0.875rem' }}>
            Recipes Over Target
          </div>
        </div>
      </div>

      {/* Venue Details */}
      <div className="card card-lg">
        <h2 style={{ 
          fontSize: '1.25rem',
          fontWeight: '600',
          marginBottom: '1.5rem',
        }}>
          Venue Breakdown
        </h2>

        <div style={{ 
          display: 'grid',
          gap: '1rem',
        }}>
          {summary.venues.map((venue) => (
            <div
              key={venue.venueId}
              className="card"
              style={{
                background: 'var(--bg-secondary)',
                border: '1px solid var(--border-light)',
                padding: '1.25rem',
              }}
            >
              <div style={{ 
                display: 'flex',
                justifyContent: 'space-between',
                alignItems: 'flex-start',
                marginBottom: '1rem',
              }}>
                <div>
                  <h3 style={{ 
                    fontSize: '1.125rem',
                    fontWeight: '600',
                    marginBottom: '0.25rem',
                  }}>
                    📍 {venue.venueName}
                  </h3>
                  <p style={{ 
                    fontSize: '0.875rem',
                    color: 'var(--text-tertiary)',
                  }}>
                    {venue.totalRecipes} recipe{venue.totalRecipes !== 1 ? 's' : ''}
                  </p>
                </div>
                <div style={{ 
                  fontSize: '1.5rem',
                  fontWeight: '700',
                  color: venue.averageFoodCostPercentage && 
                         venue.averageFoodCostPercentage > summary.targetThreshold 
                    ? 'var(--error)' 
                    : 'var(--success)',
                }}>
                  {formatPercentage(venue.averageFoodCostPercentage)}
                </div>
              </div>

              <div style={{ 
                display: 'grid',
                gridTemplateColumns: '1fr 1fr',
                gap: '1rem',
                paddingTop: '1rem',
                borderTop: '1px solid var(--border-light)',
              }}>
                <div>
                  <div style={{ 
                    fontSize: '0.75rem',
                    color: 'var(--text-tertiary)',
                    marginBottom: '0.25rem',
                  }}>
                    Average Cost %
                  </div>
                  <div style={{ 
                    fontSize: '1rem',
                    fontWeight: '600',
                  }}>
                    {formatPercentage(venue.averageFoodCostPercentage)}
                  </div>
                </div>
                <div>
                  <div style={{ 
                    fontSize: '0.75rem',
                    color: 'var(--text-tertiary)',
                    marginBottom: '0.25rem',
                  }}>
                    Over Threshold
                  </div>
                  <div style={{ 
                    fontSize: '1rem',
                    fontWeight: '600',
                    color: venue.recipesExceedingThreshold > 0 
                      ? 'var(--warning)' 
                      : 'var(--success)',
                  }}>
                    {venue.recipesExceedingThreshold} recipe{venue.recipesExceedingThreshold !== 1 ? 's' : ''}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div style={{ 
          marginTop: '1.5rem',
          padding: '1rem',
          background: 'var(--bg-secondary)',
          borderRadius: '0.5rem',
          fontSize: '0.875rem',
          color: 'var(--text-secondary)',
        }}>
          <strong>Target Threshold:</strong> {formatPercentage(summary.targetThreshold)}
        </div>
      </div>
    </div>
  );
};
